PORT=5000
NODE_ENV=development

# JWT Details
JWT_SECRET=supersecretjwtkeyfornovafinance123
JWT_REFRESH_SECRET=anothersecretrefreshkeyfornovafinance456
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database — using SQLite for local development (zero config, works instantly)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# ── PostgreSQL (uncomment and fill in once you confirm credentials in pgAdmin) ──
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hidelfinance
# DB_USER=postgres
# DB_PASSWORD=your_actual_password_here
# DB_SSL=false
